# PostgreSQL容器 helloagents-trip-postgres
DATABASE_URL=postgresql+asyncpg://postgres:请替换为本地密码@127.0.0.1:5432/app

# 服务地址与端口
PORT=8000

# 高德地图 Web/MCP API
AMAP_API_KEY=请填入高德地图Web服务Key
AMAP_MAPS_API_KEY=请填入高德地图MCP Key

# LLM
LLM_API_KEY=请填入模型服务Key
OPENAI_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL_ID=gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini
PLANNER_MODE=auto
PLANNER_INIT_TIMEOUT_SECONDS=60
PLANNER_EXECUTION_TIMEOUT_SECONDS=60
PLANNER_MAX_TOOL_ITERATIONS=4
PLANNER_MAX_REACT_STEPS=8
PLANNER_MAX_STALLED_STEPS=2
REQUIRED_MEAL_TYPES=breakfast,lunch,dinner
PLANNER_CANDIDATE_LIMIT=6
MCP_LOG_PATH=logs/mcp_calls.log
LLM_TIMEOUT_SECONDS=90
LLM_MAX_TOKENS=4096
CHROMA_PERSIST_DIRECTORY=data/chroma
CHROMA_COLLECTION_NAME=amap_pois
POI_VECTOR_TOP_K=10
# Chroma 余弦距离阈值：越小越相似，超过阈值自动转高德 POI
POI_VECTOR_DISTANCE_THRESHOLD=0.55
DISTRICT_GEO_RADIUS_KM=25
# 高德 HTTP 超时（秒）
AMAP_CONNECT_TIMEOUT_SECONDS=5
AMAP_READ_TIMEOUT_SECONDS=12
AMAP_REQUEST_RETRIES=1

# JWT / 账号
JWT_SECRET=请替换为随机字符串
JWT_EXPIRE_MINUTES=10080
AUTH_USERNAME=admin
AUTH_PASSWORD=admin123

# OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/github/callback
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REDIRECT_URI=http://localhost:8000/api/auth/wechat/callback
